module scan_code_to_bus (
    input  logic clk_50mhz,
    input  logic reset,         
    input  logic [7:0] rx_data, 
    input  logic rx_valid,      
    
    // 19 nota — C4 başlangıç oktavında (octave_shift ile kaydırılır)
    // ----------------------------------------------------------------
    // Klavye: Dell Türkçe F — fiziksel PS/2 scan code'lar kullanılır.
    //
    // BİT HARİTASI:
    //  Beyaz tuşlar (üst harf sırası, soldan sağa):
    //   [0]=C  'F'→15h  [1]=D  'G'→1Dh  [2]=E  'Ğ'→24h
    //   [3]=F  'I'→2Dh  [4]=G  'O'→2Ch  [5]=A  'D'→35h
    //   [6]=B  'R'→3Ch  [7]=C' 'N'→43h  [8]=D' 'H'→44h
    //   [9]=E' 'P'→4Dh  [10]=F''Q'→54h
    //  Siyah tuşlar (sayı sırası, soldan sağa):
    //   [11]=C#'2'→1Eh  [12]=D#'3'→26h  [13]=F#'5'→2Eh
    //   [14]=G#'6'→36h  [15]=A#'7'→3Dh  [16]=C#''9'→46h
    //   [17]=D#''0'→45h [18]=F#''-'→4Eh
    //
    //  Oktav kontrolü:
    //   F5 → bir oktav aşağı (min: oktav 0 = C2 bazlı)
    //   F6 → bir oktav yukarı (max: oktav 3 = C5 bazlı)
    //   Başlangıç: oktav 2 = C4 bazlı
    //
    //  Waveform : F1=Sine  F2=Square  F3=Triangle  F4=Sawtooth
    //  Reset    : ESC → 76h
    // ----------------------------------------------------------------
    output logic [18:0] key_state_bus,  
    output logic [1:0]  waveform_select,
    output logic [1:0]  octave_shift,   // 0=C2 baz, 1=C3 baz, 2=C4 baz, 3=C5 baz
    output logic        soft_reset             
);

    typedef enum logic {
        IDLE,
        BREAK_WAIT
    } state_t;

    state_t state; 

    always_ff @(posedge clk_50mhz or posedge reset) begin
        if (reset) begin
            state           <= IDLE;
            key_state_bus   <= 19'b0;
            waveform_select <= 2'b00;
            octave_shift    <= 2'd2;   // Başlangıç: C4 bazlı
            soft_reset      <= 1'b0;
        end else begin
            soft_reset <= 1'b0; 
            
            if (rx_valid) begin
                if (state == IDLE) begin
                    if (rx_data == 8'hF0) begin
                        state <= BREAK_WAIT; 
                    end else begin
                        case (rx_data)
                            // -----------------------------------------------
                            // BEYAZ TUŞLAR — üst harf sırası
                            // -----------------------------------------------
                            8'h15: key_state_bus[0]  <= 1'b1; // 'F'  → C
                            8'h1D: key_state_bus[1]  <= 1'b1; // 'G'  → D
                            8'h24: key_state_bus[2]  <= 1'b1; // 'Ğ'  → E
                            8'h2D: key_state_bus[3]  <= 1'b1; // 'I'  → F
                            8'h2C: key_state_bus[4]  <= 1'b1; // 'O'  → G
                            8'h35: key_state_bus[5]  <= 1'b1; // 'D'  → A
                            8'h3C: key_state_bus[6]  <= 1'b1; // 'R'  → B
                            8'h43: key_state_bus[7]  <= 1'b1; // 'N'  → C'
                            8'h44: key_state_bus[8]  <= 1'b1; // 'H'  → D'
                            8'h4D: key_state_bus[9]  <= 1'b1; // 'P'  → E'
                            8'h54: key_state_bus[10] <= 1'b1; // 'Q'  → F'

                            // -----------------------------------------------
                            // SİYAH TUŞLAR — sayı sırası
                            // -----------------------------------------------
                            8'h1E: key_state_bus[11] <= 1'b1; // '2'  → C#
                            8'h26: key_state_bus[12] <= 1'b1; // '3'  → D#
                            8'h2E: key_state_bus[13] <= 1'b1; // '5'  → F#
                            8'h36: key_state_bus[14] <= 1'b1; // '6'  → G#
                            8'h3D: key_state_bus[15] <= 1'b1; // '7'  → A#
                            8'h46: key_state_bus[16] <= 1'b1; // '9'  → C#'
                            8'h45: key_state_bus[17] <= 1'b1; // '0'  → D#'
                            8'h4E: key_state_bus[18] <= 1'b1; // '-'  → F#'

                            // -----------------------------------------------
                            // OKTAV KAYDIRMA (F5, F6)
                            // -----------------------------------------------
                            8'h03: begin // F5 → bir oktav aşağı
                                if (octave_shift != 2'd0)
                                    octave_shift <= octave_shift - 2'd1;
                            end
                            8'h0B: begin // F6 → bir oktav yukarı
                                if (octave_shift != 2'd3)
                                    octave_shift <= octave_shift + 2'd1;
                            end

                            // -----------------------------------------------
                            // WAVEFORM KONTROLÜ (F1–F4)
                            // -----------------------------------------------
                            8'h05: waveform_select <= 2'b00; // F1 → Sine
                            8'h06: waveform_select <= 2'b01; // F2 → Square
                            8'h04: waveform_select <= 2'b10; // F3 → Triangle
                            8'h0C: waveform_select <= 2'b11; // F4 → Sawtooth

                            // -----------------------------------------------
                            // KLAVYE RESETİ
                            // -----------------------------------------------
                            8'h76: soft_reset <= 1'b1;        // ESC
                        endcase
                    end
                end else if (state == BREAK_WAIT) begin
                    // Oktav ve waveform tuşlarında break yoksayılır (toggle)
                    case (rx_data)
                        // Beyaz tuşlar
                        8'h15: key_state_bus[0]  <= 1'b0;
                        8'h1D: key_state_bus[1]  <= 1'b0;
                        8'h24: key_state_bus[2]  <= 1'b0;
                        8'h2D: key_state_bus[3]  <= 1'b0;
                        8'h2C: key_state_bus[4]  <= 1'b0;
                        8'h35: key_state_bus[5]  <= 1'b0;
                        8'h3C: key_state_bus[6]  <= 1'b0;
                        8'h43: key_state_bus[7]  <= 1'b0;
                        8'h44: key_state_bus[8]  <= 1'b0;
                        8'h4D: key_state_bus[9]  <= 1'b0;
                        8'h54: key_state_bus[10] <= 1'b0;
                        // Siyah tuşlar
                        8'h1E: key_state_bus[11] <= 1'b0;
                        8'h26: key_state_bus[12] <= 1'b0;
                        8'h2E: key_state_bus[13] <= 1'b0;
                        8'h36: key_state_bus[14] <= 1'b0;
                        8'h3D: key_state_bus[15] <= 1'b0;
                        8'h46: key_state_bus[16] <= 1'b0;
                        8'h45: key_state_bus[17] <= 1'b0;
                        8'h4E: key_state_bus[18] <= 1'b0;
                    endcase
                    state <= IDLE; 
                end
            end
        end
    end
endmodule
